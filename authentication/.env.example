PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/authentication?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Resend Email Service (Recommended for Render & Production - HTTP API over port 443)
RESEND_API_KEY=re_123456789abcdef
RESEND_FROM_EMAIL="CivicReach <onboarding@resend.dev>"

# Legacy SMTP / Gmail (Optional fallback)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

